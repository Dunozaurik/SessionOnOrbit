class_name ScheduleLines

## Тексты для доски «Расписание». Каждый раз собирается случайное расписание
## из PAIRS_PER_DAY предметов, а иногда вместо него выводится объявление.
## Меняй предметы здесь — формат: "Предмет — аудитория / шутка".

const PAIRS_PER_DAY := 3
## Вероятность, что вместо расписания покажется объявление.
const NOTICE_CHANCE := 0.25

const SUBJECTS: Array[String] = [
	"Высшая математика — ауд. i (мнимая: существует только на бумаге)",
	"Физика — ауд. 3¾ (вход через шлюз между 3 и 4)",
	"Физкультура в невесомости — форма одежды: скафандр",
	"Начертательная геометрия в 4D — ауд. 8 (лежачая)",
	"Окно — в космос. Не открывать",
	"Программирование — 90% времени ищем пропущенную точку с запятой, 10% — любуемся звёздами",
	"Информатика: основы программирования — закрыли все. Еле-еле. Вспоминаем с уважением и лёгкой дрожью",
	"Экология — есть у кабинета запрещено. Особенно из «Вкусно и точка». Андрей, Ярик, Костя — это вам",
	"История — вход с арбузами строго запрещён (прецедент имеется)",
	"Физические основы микроэлектроники — тест в Moodle: 20 минут. Рекорд группы — 0 сдавших. Рекорд преподавателя — 4 минуты",
	"БЖД в открытом космосе — закрыть сложнее, чем всё программирование вместе взятое. Почему — не знает никто",
	"Деканат — явка обязательна, причина: узнаешь на месте",
	"Военная кафедра — ауд. [ЗАСЕКРЕЧЕНО]",
	"Самостоятельная работа — аудиторию тоже найди самостоятельно",
	"Иностранный язык — инопланетный, 2-я подгруппа",
	"Философия — ауд. ? (существует ли аудитория?)",
	"Инженерная графика — линейки привязаны к столам",
	"Электротехника — лаба №1: найди, где фаза. Подсказка: не пальцем",
]

const NOTICES: Array[String] = [
	"ВНИМАНИЕ: расписание изменено.\nНовое расписание будет изменено.\nСледите за изменениями изменений.",
	"Все пары перенесены на вчера.\nПросьба не опаздывать.",
	"Сегодня пар нет.\n(Это расписание на прошлый семестр.)",
	"Ошибка 404: расписание не найдено.\nОбратитесь в деканат.\nДеканат не найден.",
]


## Возвращает текст для доски: случайное расписание или объявление.
static func generate() -> String:
	if randf() < NOTICE_CHANCE:
		return NOTICES.pick_random()
	var subjects := SUBJECTS.duplicate()
	subjects.shuffle()
	var lines: Array[String] = []
	for i in PAIRS_PER_DAY:
		lines.append("%d пара — %s" % [i + 1, subjects[i]])
	return "\n".join(lines)
