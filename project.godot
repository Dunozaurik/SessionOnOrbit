;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Сессия на орбите"
config/description="3D-квест о студенте, который пытается закрыть сессию на космической станции."
config/version="0.3.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Dialogue="*res://scenes/ui/dialogue_box.tscn"
AndreyTrip="*res://scripts/autoload/andrey_trip.gd"
Transition="*res://scenes/ui/transition.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

